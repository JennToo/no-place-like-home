#!/usr/bin/env python3
import os
import sys
import pathlib
import subprocess

dest = "/tmp/last-build.log"
os.environ["PYTHONUNBUFFERED"] = "1"

pathlib.Path(dest).write_text(f"WORKING_DIRECTORY {os.getcwd()}\n")

tee = subprocess.Popen(["/usr/bin/tee", "-a", dest], stdin=subprocess.PIPE)
os.dup2(tee.stdin.fileno(), sys.stdout.fileno(), inheritable=True)
os.execvp(file=sys.argv[1], args=sys.argv[1:])
