#!/usr/bin/env python3
import sys
import re
import pathlib
import argparse

PATTERNS = [
    # python
    re.compile(r"\s*File \"(?P<file>.*)\", line (?P<line>\d+)"),
    # work
    re.compile(
        r"\w+: \*(?P<type>\w),\w+ \((?P<file>.*),(?P<line>\d+)\|(?P<col>\d+)\): (?P<message>.*)"
    ),
    # Quartus - Example:
    # Warning (15610): No output dependent on input pin "ENET1_RX_DATA[0]" File: /home/jwilcox/repo/jennifer-learns-vhdl/synth/DE2-115/Computer/DE2_115_Computer.vhd Line: 100
    re.compile(
        r"\s*(?P<type>Warning|Error) \(\d+\): (?P<message>.*) File: (?P<file>.*) Line: (?P<line>\d+)"
    ),
    # GHDL - Example:
    # test/tb_vga.vhd:55:30:error: no declaration for "r_fifo_empty"
    re.compile(
        r"(?P<file>[^:]+):(?P<line>\d+):(?P<col>\d+):(?P<type>[^:]+): (?P<message>.+)"
    )
]


def main():
    args = parse_args()
    log_file = pathlib.Path(args.log)
    for line_number, line in enumerate(log_file.read_text().splitlines(keepends=False)):
        for pattern in PATTERNS:
            match = pattern.match(line)
            if not match:
                continue
            groups_to_print = ["type", "file", "line", "col", "message"]
            groups_found = {
                "type": "E",
                "file": "/dev/null",
                "line": 0,
                "col": 0,
                "message": "none",
            }
            for group in groups_to_print:
                try:
                    groups_found[group] = match.group(group)
                    if group == "type":
                        groups_found[group] = groups_found[group][:1]
                except IndexError:
                    pass

            logfile_groups = groups_found.copy()
            logfile_groups["col"] = "0"
            logfile_groups["file"] = str(log_file)
            logfile_groups["line"] = str(line_number + 1)

            if (
                args.level is not None
                and args.level.lower() == "e"
                and groups_found["type"].lower() != "e"
            ):
                continue
            print_one(groups_found)
            print_one(logfile_groups)


def print_one(groups_found):
    print(" ".join(f"{key} {value}" for key, value in groups_found.items()))


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("log", help="Log file to parse")
    parser.add_argument("-l", "--level", help="Level of messages to show", default=None)
    return parser.parse_args()


if __name__ == "__main__":
    main()
