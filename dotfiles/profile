#!/bin/bash

if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

PATH="$HOME/.cargo/bin:$PATH"

export P4CONFIG=.p4config
export P4IGNORE=.p4ignore

export VISUAL="nvim"
export EDITOR="nvim"

export FZF_DEFAULT_COMMAND="fdfind --type f -I --ignore-file $HOME/.fdignore"

if [ -e "/home/jwilcox/.local/share/gem/ruby/3.2.0/bin/" ]
then
    PATH="$PATH:/home/jwilcox/.local/share/gem/ruby/3.2.0/bin"
fi

# Overriding ansible-generated var
if false; then
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
fi
