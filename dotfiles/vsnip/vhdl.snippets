snippet testbench
	library std;
	use std.env.all;

	library ieee;
	use ieee.std_logic_1164.all;
	use ieee.numeric_std.all;

	entity tb_${1:name} is
	end entity tb_${1:name};

	architecture behave of tb_${1:name} is
		constant CLK_PERIOD : time := 10 ns;

		signal clk  : std_logic := '0';
		signal rst  : std_logic := '1';
	begin
		clk <= not clk after CLK_PERIOD / 2;

		${2}

		stimulus_p: process
		begin
			rst <= '1';
			wait for CLK_PERIOD;
			rst <= '0';

			finish;
		end process stimulus_p;
	end architecture behave;
snippet cmp
	library ieee;
	  use ieee.std_logic_1164.all;
	  use ieee.numeric_std.all;

	entity ${1:name} is
	  generic (
	  );
	  port (
	    i_clk : in std_logic;
	    i_rst : in std_logic;
	  );
	end entity ${1:name};

	architecture rtl of ${1:name} is
	begin
	  ${2}
	end architecture rtl;
snippet instp
	u_${1:name} : entity work.${1:name}
	port map (
	  i_clk => i_clk,
	  i_rst => i_rst,
	  ${2}
	);

snippet sclockp
	${1:name}: process(i_clk) is
	begin
		if rising_edge(i_clk) then
			if (i_rst = '1') then
				${2}
			else
				${3}
			end if;
		end if;
	end process ${1:name};

snippet oz
	(others => '0');
snippet pkg
	library ieee;
	  use ieee.std_logic_1164.all;

	package ${1} is
	end package ${1};

	package body ${1} is
	end package body ${1};
