[user]
	email = {{ git_email }}
	name = Jennifer Wilcox
[core]
	excludesfile = /home/jwilcox/.gitignore
	quotePath = false
	hooksPath = /dev/null
[diff]
	external = difft
[init]
	defaultbranch = main
[pull]
	rebase = false
[credential "https://github.adtran.com"]
	username = jwilcox
	helper = !/usr/bin/gh auth git-credential
[submodule]
	recurse = true
[push]
	recurseSubmodules = check
[fetch]
	recurseSubmodules = on-demand
	prune = true
